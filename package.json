{
  "name": "@fett/jexpath",
  "version": "0.0.2",
  "description": "JexPath is a library that allows you to use JSONPath expressions in Jexl.",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "keywords": [
    "jexl",
    "jsonpath",
    "expression"
  ],
  "type": "module",
  "author": "ChrisSong1994 <https://github.com/ChrisSong1994>",
  "scripts": {
    "dev": "npm run clean && concurrently --kill-others \"tsc --sourceMap -w\" \"tsc-alias -w\"",
    "build": "npm run clean && tsc  && tsc-alias",
    "example": "npm run dev --prefix examples",
    "example:build": "npm run build --prefix examples",
    "prepublish": "npm run build",
    "clean": "rimraf lib",
    "pub": "npm publish --access=public",
    "pub:beta": "npm publish --access=public --tag=beta",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.3",
  "dependencies": {
    "dayjs": "^1.11.19",
    "jexl": "^2.3.0",
    "jsonpath-plus": "^10.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.0.18",
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
