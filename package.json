{
  "name": "@fett/jexpath",
  "version": "0.0.1-beta.2",
  "description": "JexPath is a library that allows you to use JSONPath expressions in Jexl.",
  "main": "./lib/index.js",
  "keywords": [
    "jexl",
    "jsonpath",
    "expression"
  ],
  "type": "module",
  "author": "ChrisSong1994 <https://github.com/ChrisSong1994>",
  "scripts": {
    "dev": "npm run clean && concurrently --kill-others \"tsc --sourceMap -w\" \"tsc-alias -w\"",
    "build": "npm run clean && tsc  && tsc-alias",
    "prepublish": "npm run build",
    "clean": "rimraf lib",
    "pub": "npm publish --access=public",
    "pub:beta": "npm publish --access=public --tag=beta",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.3",
  "dependencies": {
    "dayjs": "^1.11.19",
    "jexl": "^2.3.0",
    "jsonpath-plus": "^10.3.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
